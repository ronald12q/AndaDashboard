# Server
PORT=3000
# Para despliegue detrás de un proxy local:
HOST=127.0.0.1
TRUST_LOCAL_PROXY=false
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# Auth (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Requerido: dominios institucionales aprobados, separados por comas. Sin valor por defecto.
ADMIN_EMAIL_DOMAINS=

# RAG opcional: servicio FastAPI separado, solo en loopback.
RAG_URL=
